{
  "name": "Pulse — Recovery, Strain & Sleep",
  "short_name": "Pulse",
  "description": "A private, offline dashboard for your Apple Health export. Recovery, strain and sleep computed on your device and stored on your device — never uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#070A10",
  "theme_color": "#070A10",
  "categories": ["health", "fitness", "lifestyle"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Import a new export",
      "short_name": "Import",
      "url": "./?action=import",
      "description": "Add a fresh Apple Health export to your existing data"
    }
  ]
}
